@model HouseHold.Models.MonthlyBudget

@{
    ViewData["Title"] = "月間予算削除";
}

<h1>月間予算削除</h1>

<h3>この月間予算を削除してもよろしいですか?</h3>
<div>
    <h4>月間予算</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.YearNum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearNum)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MonthNum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MonthNum)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BudgetAmount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BudgetAmount)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MonthlyBudgetId" />
        <input type="submit" value="削除" class="btn btn-danger" /> |
        <a asp-action="Index">一覧に戻る</a>
    </form>
</div>
