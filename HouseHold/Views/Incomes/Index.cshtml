@model IEnumerable<HouseHold.Models.Income>

@{
    ViewData["Title"] = "収入一覧";
}

<h1>収入一覧</h1>

<p>
    <a asp-action="Create">新規作成</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Posted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IncomeClassNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Posted)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IncomeClassNavigation.IncomeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IncomeId">編集</a> |
                <a asp-action="Details" asp-route-id="@item.IncomeId">詳細</a> |
                <a asp-action="Delete" asp-route-id="@item.IncomeId">削除</a>
            </td>
        </tr>
}
    </tbody>
</table>
