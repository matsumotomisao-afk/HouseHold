@model IEnumerable<HouseHold.Models.PaymentMethod>

@{
    ViewData["Title"] = "支払方法一覧";
}

<h1>支払方法一覧</h1>

<p>
    <a asp-action="Create">新規作成</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MethodName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentTypeId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MethodName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentTypeId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PaymentMethodId">編集</a> |
                <a asp-action="Details" asp-route-id="@item.PaymentMethodId">詳細</a> |
                <a asp-action="Delete" asp-route-id="@item.PaymentMethodId">削除</a>
            </td>
        </tr>
}
    </tbody>
</table>
