@model HouseHold.Models.PaymentMethod

@{
    ViewData["Title"] = "支払方法削除";
}

<h1>支払方法削除</h1>

<h3>この支払方法を削除してもよろしいですか?</h3>
<div>
    <h4>支払方法</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MethodName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MethodName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentTypeId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentTypeId)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="PaymentMethodId" />
        <input type="submit" value="削除" class="btn btn-danger" /> |
        <a asp-action="Index">一覧に戻る</a>
    </form>
</div>
