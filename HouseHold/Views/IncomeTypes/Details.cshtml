@model HouseHold.Models.IncomeType

@{
    ViewData["Title"] = "所得の種類詳細";
}

<h1>所得の種類詳細</h1>

<div>
    <h4>所得の種類</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            所得区分
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IncomeClass.IncomeName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TypeName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TypeName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IncomeTypeId">編集</a> |
    <a asp-action="Index">一覧に戻る</a>
</div>
