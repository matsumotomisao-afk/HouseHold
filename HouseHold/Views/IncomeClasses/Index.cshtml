@model IEnumerable<HouseHold.Models.IncomeClass>

@{
    ViewData["Title"] = "所得区分一覧";
}

<h1>所得区分一覧</h1>

<p>
    <a asp-action="Create">新規作成</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IncomeName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IncomeName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IncomeClassId">編集</a> |
                <a asp-action="Details" asp-route-id="@item.IncomeClassId">詳細</a> |
                <a asp-action="Delete" asp-route-id="@item.IncomeClassId">削除</a>
            </td>
        </tr>
}
    </tbody>
</table>
