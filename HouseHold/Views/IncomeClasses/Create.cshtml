@model HouseHold.Models.IncomeClass

@{
    ViewData["Title"] = "所得区分作成";
}

<h1>所得区分作成</h1>

<h4>所得区分</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IncomeName" class="control-label"></label>
                <input asp-for="IncomeName" class="form-control" />
                <span asp-validation-for="IncomeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="作成" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">一覧に戻る</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
